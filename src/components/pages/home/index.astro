---
import type { Locale } from "@/lib/i18n";
import { getDictionary, localizePath } from "@/lib/i18n";
import { getVersion } from "@/lib/versions";
import { cn } from "@/lib/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const prompt = "guest@glyndor:~$";
const podupVersion = getVersion("Glyndor/podup");

const dotClass = (status: string) =>
	status === "released"
		? "text-signal-green"
		: status === "comingSoon"
			? "text-accent"
			: "text-signal-amber";

const podup = t.projects.podup;
const helmly = t.projects.helmly;
const epistle = t.projects.epistle;
const authcore = t.projects.authcore;
const unitpm = t.projects.unitpm;
const klyradb = t.projects.klyradb;
const specio = t.projects.specio;
const viden = t.projects.viden;

// Precomputed `tree ./projects` rows.
const tree = [
	{
		c: "├──",
		name: "podup/",
		href: localizePath("/projects/podup", locale),
		desc: podup.tagline,
		status: t.statuses[podup.status],
		version: podupVersion,
		versionRepo: "Glyndor/podup",
		dot: dotClass(podup.status),
	},
	{
		c: "├──",
		name: "helmly/",
		href: localizePath("/projects/helmly", locale),
		desc: helmly.tagline,
		status: t.statuses[helmly.status],
		dot: dotClass(helmly.status),
	},
	{
		c: "│   └──",
		name: "helmly-agent",
		href: localizePath("/projects/helmly-agent", locale),
		desc: t.home.tree.helmlyAgent,
		component: true,
	},
	{
		c: "├──",
		name: "epistle/",
		href: localizePath("/projects/epistle", locale),
		desc: epistle.tagline,
		status: t.statuses[epistle.status],
		dot: dotClass(epistle.status),
	},
	{
		c: "│   └──",
		name: "epistle-panel",
		href: localizePath("/projects/epistle-panel", locale),
		desc: t.home.tree.epistlePanel,
		component: true,
	},
	{
		c: "├──",
		name: "authcore/",
		href: localizePath("/projects/authcore", locale),
		desc: authcore.tagline,
		status: t.statuses[authcore.status],
		dot: dotClass(authcore.status),
	},
	{
		c: "├──",
		name: "unitpm/",
		href: localizePath("/projects/unitpm", locale),
		desc: unitpm.tagline,
		status: t.statuses[unitpm.status],
		dot: dotClass(unitpm.status),
	},
	{
		c: "├──",
		name: "klyradb/",
		href: localizePath("/projects/klyradb", locale),
		desc: klyradb.tagline,
		status: t.statuses[klyradb.status],
		dot: dotClass(klyradb.status),
	},
	{
		c: "├──",
		name: "specio/",
		href: localizePath("/projects/specio", locale),
		desc: specio.tagline,
		status: t.statuses[specio.status],
		dot: dotClass(specio.status),
	},
	{
		c: "└──",
		name: "viden/",
		href: localizePath("/projects/viden", locale),
		desc: viden.tagline,
		status: t.statuses[viden.status],
		dot: dotClass(viden.status),
	},
];

const banner = ` ██████╗ ██╗  ██╗   ██╗███╗   ██╗██████╗  ██████╗ ██████╗
██╔════╝ ██║  ╚██╗ ██╔╝████╗  ██║██╔══██╗██╔═══██╗██╔══██╗
██║  ███╗██║   ╚████╔╝ ██╔██╗ ██║██║  ██║██║   ██║██████╔╝
██║   ██║██║    ╚██╔╝  ██║╚██╗██║██║  ██║██║   ██║██╔══██╗
╚██████╔╝███████╗██║   ██║ ╚████║██████╔╝╚██████╔╝██║  ██║
 ╚═════╝ ╚══════╝╚═╝   ╚═╝  ╚═══╝╚═════╝  ╚═════╝ ╚═╝  ╚═╝`;
---

<div class="w-full px-4 py-16 text-sm leading-relaxed sm:px-8 lg:px-16 xl:px-24 sm:text-[15px]">
	<!-- ASCII banner -->
	<h1 class="sr-only">Glyndor</h1>
	<div class="rise">
		<pre aria-hidden="true" class="ascii">{banner}</pre>
	</div>
	<p class="rise mt-3 text-muted-foreground" style="animation-delay:60ms">
		<span class="text-muted-foreground/60">//</span>
		<span class="ml-2">{t.footer.tagline}</span>
	</p>

	<!-- session -->
	<div class="mt-12 space-y-2">
		<!-- whoami -->
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="type ml-2 text-foreground" style="--w:6ch;--n:6;animation-delay:.3s">whoami</span
			>
		</p>
		<p class="stream pb-4 text-foreground/90 glow-text" style="animation-delay:.9s">
			{t.home.console.identity}
		</p>

		<!-- cat mission -->
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="type ml-2 text-foreground" style="--w:17ch;--n:17;animation-delay:1.2s"
				>cat ./mission.txt</span
			>
		</p>
		<p class="stream max-w-4xl pb-4 text-muted-foreground" style="animation-delay:1.85s">
			{t.home.hero.subtitle}
		</p>

		<!-- tree -->
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="type ml-2 text-foreground" style="--w:15ch;--n:15;animation-delay:2.15s"
				>tree ./projects</span
			>
		</p>
		<div class="stream pt-1" style="animation-delay:2.75s">
			<p class="text-muted-foreground">./projects</p>
			{
				tree.map((row) => (
					<a
						href={row.href}
						class="group grid grid-cols-[auto_1fr] gap-x-2 py-1 hover:bg-accent-soft sm:grid-cols-[5.5rem_11rem_1fr_auto]"
					>
						<span class="whitespace-pre text-muted-foreground/50">{row.c} </span>
						<span
							class={
								row.component
									? "text-muted-foreground group-hover:text-accent"
									: "font-semibold text-foreground group-hover:text-accent"
							}
						>
							{!row.component && (
								<span
									class={cn("mr-1.5 inline-block size-2 rounded-full shadow-[0_0_8px_currentColor]", row.dot)}
								/>
							)}
							{row.name}
						</span>
						<span class="col-span-2 truncate text-muted-foreground/80 sm:col-span-1">
							{row.desc}
						</span>
						{row.status && (
							<span class="hidden whitespace-nowrap text-xs uppercase tracking-wider text-muted-foreground sm:inline">
								[{row.status}
								{row.version && (
									<>
										{" · "}
										{row.version}
									</>
								)}
								]
							</span>
						)}
					</a>
				))
			}
		</div>

		<!-- final prompt + actions -->
		<p class="stream pt-7" style="animation-delay:3.1s">
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-muted-foreground/80"># {t.home.console.hint}</span>
			<span class="caret" aria-hidden="true"></span>
		</p>

		<div class="stream flex flex-col gap-1 pt-2 sm:flex-row sm:gap-8" style="animation-delay:3.3s">
			<a
				href={localizePath("/projects", locale)}
				class="group text-foreground transition-colors hover:text-accent"
			>
				<span class="text-accent">$</span> ./explore --projects
				<span class="text-muted-foreground/50 transition-colors group-hover:text-accent"
					>→</span
				>
			</a>
			<a
				href="https://github.com/Glyndor"
				target="_blank" rel="noopener"
				class="group text-muted-foreground transition-colors hover:text-foreground"
			>
				<span class="text-accent">$</span> git clone github.com/Glyndor
			</a>
			<a
				href={localizePath("/support", locale)}
				class="group text-muted-foreground transition-colors hover:text-accent"
			>
				<span class="text-accent">$</span> glyndor support
				<span class="text-muted-foreground/50 transition-colors group-hover:text-accent">♥</span>
			</a>
		</div>
	</div>

	<!-- showcase: empty until something ships on Glyndor -->
	<div class="mt-20 border-t border-border pt-10">
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-foreground">systemctl list-units --type=service glyndor-*</span>
		</p>
		<div class="mt-3 space-y-1">
			<p class="text-muted-foreground/80"># {t.home.showcase.heading}</p>
			<p class="max-w-2xl text-muted-foreground">{t.home.showcase.subheading}</p>
			<p class="pt-2 text-muted-foreground/80">0 loaded units listed.</p>
		</div>
	</div>
</div>
