---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.3"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	class={className}
>
	<rect x="5.5" y="5.5" width="8.5" height="8.5" rx="1"></rect>
	<path d="M2.5 10.5v-8A1 1 0 0 1 3.5 1.5h8"></path>
</svg>
