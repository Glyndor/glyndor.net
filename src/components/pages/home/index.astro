---
import type { Locale } from "@/lib/i18n";
import { getDictionary, localizePath } from "@/lib/i18n";
import { getVersion } from "@/lib/versions";
import { cn } from "@/lib/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const prompt = "guest@glyndor:~$";

const dotClass = (status: string) =>
	status === "released"
		? "text-signal-green dot-pulse"
		: status === "comingSoon"
			? "text-accent"
			: "text-signal-amber";

// Release tags come from src/data/versions.json (kept fresh by version-bump
// CI), keyed by "<owner>/<repo>" -- same source project/index.astro reads.
const versionFor = (repo: string) => getVersion(repo.replace("https://github.com/", ""));

const podup = t.projects.podup;
const helmly = t.projects.helmly;
const epistle = t.projects.epistle;
const authcore = t.projects.authcore;
const unitpm = t.projects.unitpm;
const klyradb = t.projects.klyradb;
const specio = t.projects.specio;
const viden = t.projects.viden;

const projectRow = (
	c: string,
	slug: string,
	project: { tagline: string; status: (typeof podup)["status"]; repo: string },
) => ({
	c,
	name: `${slug}/`,
	href: localizePath(`/projects/${slug}`, locale),
	desc: project.tagline,
	component: false,
	status: t.statuses[project.status],
	version: versionFor(project.repo),
	dot: dotClass(project.status),
});

const componentRow = (
	c: string,
	slug: string,
	desc: string,
	component: { status?: (typeof podup)["status"]; repo: string },
) => ({
	c,
	name: slug,
	href: localizePath(`/projects/${slug}`, locale),
	desc,
	component: true,
	status: component.status ? t.statuses[component.status] : undefined,
	version: component.status ? versionFor(component.repo) : null,
	dot: component.status ? dotClass(component.status) : undefined,
});

// Precomputed `tree ./projects` rows.
const tree = [
	projectRow("├──", "podup", podup),
	projectRow("├──", "helmly", helmly),
	componentRow("│   └──", "helmly-agent", t.home.tree.helmlyAgent, helmly.components[0]),
	projectRow("├──", "epistle", epistle),
	componentRow("│   └──", "epistle-panel", t.home.tree.epistlePanel, epistle.components[0]),
	projectRow("├──", "authcore", authcore),
	projectRow("├──", "unitpm", unitpm),
	projectRow("├──", "klyradb", klyradb),
	projectRow("├──", "specio", specio),
	projectRow("└──", "viden", viden),
];

const banner = ` ██████╗ ██╗  ██╗   ██╗███╗   ██╗██████╗  ██████╗ ██████╗
██╔════╝ ██║  ╚██╗ ██╔╝████╗  ██║██╔══██╗██╔═══██╗██╔══██╗
██║  ███╗██║   ╚████╔╝ ██╔██╗ ██║██║  ██║██║   ██║██████╔╝
██║   ██║██║    ╚██╔╝  ██║╚██╗██║██║  ██║██║   ██║██╔══██╗
╚██████╔╝███████╗██║   ██║ ╚████║██████╔╝╚██████╔╝██║  ██║
 ╚═════╝ ╚══════╝╚═╝   ╚═╝  ╚═══╝╚═════╝  ╚═════╝ ╚═╝  ╚═╝`;
---

<div class="w-full px-4 py-16 text-sm leading-relaxed sm:px-8 lg:px-16 xl:px-24 sm:text-[15px]">
	<!-- ASCII banner -->
	<h1 class="sr-only">Glyndor</h1>
	<div class="rise">
		<pre aria-hidden="true" class="ascii">{banner}</pre>
	</div>
	<p class="rise mt-3 text-muted-foreground" style="animation-delay:60ms">
		<span class="text-muted-foreground/60">//</span>
		<span class="ml-2">{t.footer.tagline}</span>
	</p>

	<!-- session -->
	<div class="mt-12 space-y-2">
		<!-- whoami -->
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="type ml-2 text-foreground" style="--w:6ch;--n:6;animation-delay:.15s">whoami</span
			>
		</p>
		<p class="stream pb-4 text-foreground/90 glow-text" style="animation-delay:.5s">
			<span class="sr-only">{t.home.console.identities[0]}</span>
			<span
				id="whoami-output"
				aria-hidden="true"
				data-phrases={JSON.stringify(t.home.console.identities)}
				>{t.home.console.identities[0]}</span
			><span class="cursor-blink" aria-hidden="true"></span>
		</p>

		<!-- cat mission -->
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="type ml-2 text-foreground" style="--w:17ch;--n:17;animation-delay:.65s"
				>cat ./mission.txt</span
			>
		</p>
		<p class="stream max-w-4xl pb-4 text-muted-foreground" style="animation-delay:1s">
			{t.home.hero.subtitle}
		</p>

		<!-- tree -->
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="type ml-2 text-foreground" style="--w:15ch;--n:15;animation-delay:1.15s"
				>tree ./projects</span
			>
		</p>
		<div class="stream pt-1" style="animation-delay:1.5s">
			<p class="text-muted-foreground">./projects</p>
			{
				tree.map((row) => (
					<a
						href={row.href}
						class="group grid grid-cols-[auto_1fr] items-center gap-x-2 py-1 hover:bg-accent-soft sm:grid-cols-[5.5rem_11rem_1fr_auto]"
					>
						<span class="whitespace-pre text-muted-foreground/50">{row.c} </span>
						<span
							class={
								row.component
									? "flex items-center text-muted-foreground group-hover:text-accent"
									: "flex items-center font-semibold text-foreground group-hover:text-accent"
							}
						>
							{row.dot && (
								<span
									class={cn(
										"mr-1.5 inline-block size-2 rounded-full bg-current shadow-[0_0_8px_currentColor]",
										row.dot,
									)}
								/>
							)}
							{row.name}
						</span>
						<span class="col-span-2 truncate text-muted-foreground/80 sm:col-span-1">
							{row.desc}
						</span>
						{row.status && (
							<span class="hidden whitespace-nowrap text-xs uppercase tracking-wider text-muted-foreground sm:inline">
								[{row.status}
								{row.version && (
									<>
										{" · "}
										<span class="font-semibold text-accent">{row.version}</span>
									</>
								)}
								]
							</span>
						)}
					</a>
				))
			}
		</div>

		<!-- final prompt + actions -->
		<p class="stream pt-7" style="animation-delay:1.7s">
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-muted-foreground/80"># {t.home.console.hint}</span>
			<span class="caret" aria-hidden="true"></span>
		</p>

		<div class="stream flex flex-col gap-1 pt-2 sm:flex-row sm:gap-8" style="animation-delay:1.8s">
			<a
				href={localizePath("/projects", locale)}
				class="group glitch-hover text-signal-green transition-colors hover:text-accent"
			>
				<span class="text-signal-green">$</span> ./explore --projects
				<span class="text-muted-foreground/50 transition-colors group-hover:text-accent"
					>→</span
				>
			</a>
			<a
				href="https://github.com/Glyndor"
				target="_blank" rel="noopener"
				class="group glitch-hover text-muted-foreground transition-colors hover:text-foreground"
			>
				<span class="text-muted-foreground/70">$</span> git clone github.com/Glyndor
			</a>
			<a
				href={localizePath("/support", locale)}
				class="group glitch-hover text-signal-amber transition-colors hover:text-accent"
			>
				<span class="text-signal-amber">$</span> glyndor support{" "}
				<span class="transition-colors group-hover:text-accent">♥</span>
			</a>
		</div>
	</div>

	<!-- showcase: empty until something ships on Glyndor -->
	<div class="mt-20 border-t border-border pt-10">
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-foreground">systemctl list-units --type=service glyndor-*</span>
		</p>
		<div class="mt-3 space-y-1">
			<p class="text-muted-foreground/80"># {t.home.showcase.heading}</p>
			<p class="max-w-2xl text-muted-foreground">{t.home.showcase.subheading}</p>
			<p class="flicker-alert pt-2 text-signal-red">0 loaded units listed.</p>
		</div>
	</div>
</div>

<script>
	document.addEventListener("astro:page-load", () => {
		const el = document.getElementById("whoami-output");
		if (!el) return;

		const phrases = JSON.parse(el.dataset.phrases ?? "[]") as string[];
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (phrases.length < 2 || reduceMotion) return;

		const TYPE_MS = 45;
		const DELETE_MS = 25;
		const HOLD_MS = 2400;
		let phraseIndex = 0;
		let charIndex = phrases[0].length;
		let deleting = false;

		function tick() {
			const current = phrases[phraseIndex];
			if (!deleting) {
				charIndex++;
				if (charIndex > current.length) {
					deleting = true;
					setTimeout(tick, HOLD_MS);
					return;
				}
			} else {
				charIndex--;
				if (charIndex < 0) {
					deleting = false;
					phraseIndex = (phraseIndex + 1) % phrases.length;
					charIndex = 0;
					setTimeout(tick, 300);
					return;
				}
			}
			if (el) el.textContent = current.slice(0, charIndex);
			setTimeout(tick, deleting ? DELETE_MS : TYPE_MS);
		}

		setTimeout(tick, HOLD_MS);
	});
</script>
