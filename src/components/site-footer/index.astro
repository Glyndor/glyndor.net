---
import GithubIcon from "@/components/icons/github/index.astro";
import type { Locale } from "@/lib/i18n";
import { getDictionary, localizePath } from "@/lib/i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
const prompt = "guest@glyndor:~$";

const projectRows = [
	{ name: "podup", href: localizePath("/projects/podup", locale) },
	{ name: "helmly", href: localizePath("/projects/helmly", locale) },
	{ name: "epistle", href: localizePath("/projects/epistle", locale) },
	{ name: "authcore", href: localizePath("/projects/authcore", locale) },
	{ name: "unitpm", href: localizePath("/projects/unitpm", locale) },
	{ name: "klyradb", href: localizePath("/projects/klyradb", locale) },
	{ name: "specio", href: localizePath("/projects/specio", locale) },
	{ name: "viden", href: localizePath("/projects/viden", locale) },
];
---

<footer class="mt-16 border-t border-border">
	<div class="w-full px-4 py-12 text-sm sm:px-8 lg:px-16 xl:px-24">
		<p>
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-foreground">tree ~/glyndor</span>
		</p>

		<div class="mt-5 grid gap-x-16 gap-y-10 sm:grid-cols-[1.5fr_1fr_1fr]">
			<!-- identity -->
			<div>
				<p class="font-semibold">
					{t.site.name}<span class="text-accent">:~$</span>
				</p>
				<p class="mt-3 max-w-xs text-muted-foreground"># {t.footer.tagline}</p>
				<p class="mt-1 text-muted-foreground/70"># {t.footer.madeWith}</p>
			</div>

			<!-- projects/ -->
			<div>
				<p class="text-muted-foreground">{t.footer.sections.projects.toLowerCase()}/</p>
				<ul class="mt-2 space-y-1">
					{
						projectRows.map((row, i) => (
							<li class="flex gap-2">
								<span class="whitespace-pre text-muted-foreground/40">
									{i === projectRows.length - 1 ? "└──" : "├──"}
								</span>
								<a
									href={row.href}
									class="text-muted-foreground transition-colors hover:text-accent"
								>
									{row.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- resources/ -->
			<div>
				<p class="text-muted-foreground">{t.footer.sections.resources.toLowerCase()}/</p>
				<ul class="mt-2 space-y-1">
					<li class="flex gap-2">
						<span class="whitespace-pre text-muted-foreground/40">├──</span>
						<a
							href={localizePath("/support", locale)}
							class="text-muted-foreground transition-colors hover:text-accent"
						>
							{t.nav.support.toLowerCase()}
						</a>
					</li>
					<li class="flex gap-2">
						<span class="whitespace-pre text-muted-foreground/40">└──</span>
						<a
							href="https://github.com/Glyndor"
							target="_blank" rel="noopener"
							class="inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-accent"
						>
							<GithubIcon class="size-3.5" />
							{t.footer.links.github}
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- tmux status line -->
	<div class="flex w-full items-stretch border-t border-border bg-card/50 text-xs">
		<span class="flex items-center bg-accent px-3 py-1.5 font-semibold text-accent-foreground">
			{t.site.name}
		</span>
		<span class="hidden items-center px-3 text-muted-foreground sm:flex">
			{t.footer.tagline}
		</span>
		<span class="ml-auto flex items-center gap-1 px-3 py-1.5 text-muted-foreground">
			© {year} · mit
			<span class="cursor-blink" aria-hidden="true"></span>
		</span>
	</div>
</footer>
