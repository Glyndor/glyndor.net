---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	class={className}
>
	<path d="M3 8.5 6.3 12 13 4"></path>
</svg>
