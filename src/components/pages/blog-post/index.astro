---
import type { Locale } from "@/lib/i18n";
import { getDictionary, localizePath } from "@/lib/i18n";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";

interface Props {
	locale: Locale;
	slug: string;
	entry: CollectionEntry<"blog">;
}

const { locale, slug, entry } = Astro.props;
const t = getDictionary(locale);
const prompt = "guest@glyndor:~$";
const { Content } = await render(entry);
// timeZone: "UTC" -- see blog-index for why.
const dateFormatter = new Intl.DateTimeFormat(locale, {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});
---

<article class="w-full px-4 py-16 text-sm leading-relaxed sm:px-8 lg:px-16 xl:px-24 sm:text-[15px]">
	<a
		href={localizePath("/blog", locale)}
		class="rise group inline-block text-muted-foreground transition-colors hover:text-foreground"
	>
		<span class="text-accent">$</span> cd .. <span class="text-muted-foreground/80"
			># {t.blog.backToBlog}</span
		>
	</a>

	<p class="rise mt-6" style="animation-delay:60ms">
		<span class="text-accent">{prompt}</span>
		<span class="ml-2 text-foreground">cat ./blog/{slug}.md</span>
	</p>

	{
		entry.data.banner && (
			<div class="rise mt-4 overflow-hidden border border-border-strong" style="animation-delay:100ms">
				<Image src={entry.data.banner} alt="" width={1200} height={630} class="h-auto w-full" />
			</div>
		)
	}

	<div class="rise mt-4" style="animation-delay:140ms">
		<p class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.18em] text-muted-foreground">
			{t.blog.published} {dateFormatter.format(entry.data.date)}
			{
				entry.data.project && (
					<>
						<span class="text-muted-foreground/50">·</span>
						{t.blog.relatedProject}{" "}
						<a
							href={localizePath(`/projects/${entry.data.project}`, locale)}
							class="text-accent transition-colors hover:underline"
						>
							{entry.data.project}
						</a>
					</>
				)
			}
		</p>
		<h1 class="mt-3 text-3xl font-semibold sm:text-4xl">{entry.data.title}</h1>
	</div>

	<div class="post-content rise mt-8 max-w-3xl text-pretty" style="animation-delay:200ms">
		<Content />
	</div>
</article>
