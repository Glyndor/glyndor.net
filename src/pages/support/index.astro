---
import Support from "@/components/pages/support/index.astro";
import Base from "@/layouts/base/index.astro";
import { getDictionary } from "@/lib/i18n";

const locale = "en" as const;
const t = getDictionary(locale);
---

<Base locale={locale} title={`${t.support.title} — ${t.site.name}`} description={t.support.intro}>
	<Support locale={locale} />
</Base>
