---
import type { Locale } from "@/lib/i18n";
import { getDictionary, localizePath } from "@/lib/i18n";
import { getVersion } from "@/lib/versions";
import { cn } from "@/lib/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const projectKeys = [
	"podup",
	"helmly",
	"epistle",
	"authcore",
	"unitpm",
	"klyradb",
	"specio",
	"viden",
] as const;
const versionFor = (repo: string) => getVersion(repo.replace("https://github.com/", ""));

const projects = projectKeys.map((key, index) => ({
	key,
	index: String(index + 1).padStart(2, "0"),
	version: versionFor(t.projects[key].repo),
	...t.projects[key],
}));

const dotClass = (status: string) =>
	status === "released"
		? "bg-signal-green text-signal-green dot-pulse"
		: status === "comingSoon"
			? "bg-accent text-accent"
			: "bg-signal-amber text-signal-amber";

const prompt = "guest@glyndor:~$";
---

<section class="w-full px-4 py-16 sm:px-8 lg:px-16 xl:px-24">
	<div class="w-full">
		<!-- command -->
		<p class="rise text-sm">
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-foreground">cd ~/projects && ls -l</span>
		</p>
		<p class="rise mt-2 pl-4 text-sm text-muted-foreground" style="animation-delay:80ms">
			# {t.projectsIndex.subtitle}
		</p>
		<p
			class="rise mt-1 pl-4 text-xs text-muted-foreground/80"
			style="animation-delay:120ms"
		>
			total {projects.length}
		</p>

		<div
			class="rise mt-5 divide-y divide-border-strong border-y border-border-strong text-sm"
			style="animation-delay:160ms"
		>
			{
				projects.map((project) => (
					<a
						href={localizePath(`/projects/${project.key}`, locale)}
						class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-x-4 px-2 py-6 transition-colors hover:bg-accent-soft sm:grid-cols-[1.5rem_9rem_1fr_auto]"
					>
						<span class="text-muted-foreground/60">{project.index}</span>
						<span class="flex items-center gap-2 font-semibold text-foreground group-hover:text-accent">
							<span
								class={cn("size-2 rounded-full shadow-[0_0_8px_currentColor]", dotClass(project.status))}
							/>
							{project.key}/
						</span>
						<span class="col-span-2 text-muted-foreground sm:col-span-1">
							{project.tagline}
							{"components" in project &&
								project.components.map((c) => (
									<span class="ml-2 inline-flex items-center gap-1 whitespace-nowrap text-xs text-muted-foreground/80">
										{c.status && (
											<span
												class={cn("size-1.5 rounded-full shadow-[0_0_6px_currentColor]", dotClass(c.status))}
											/>
										)}
										+{c.name}
									</span>
								))}
						</span>
						<span class="hidden self-center whitespace-nowrap text-xs uppercase tracking-wider text-muted-foreground transition-colors group-hover:text-accent sm:inline">
							{t.statuses[project.status]}
							{project.version && (
								<>
									{" · "}
									<span class="font-semibold text-accent">{project.version}</span>
								</>
							)}
						</span>
					</a>
				))
			}
		</div>

		<!-- showcase -->
		<p class="rise mt-12 text-sm" style="animation-delay:220ms">
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-foreground">ls -l ~/showcase</span>
		</p>
		<p class="rise mt-2 pl-4 text-xs text-muted-foreground/80" style="animation-delay:260ms">
			# {t.home.showcase.heading.toLowerCase()}
		</p>

		<div
			class="rise mt-4 border-y border-border-strong px-2 py-6 text-sm text-muted-foreground/80"
			style="animation-delay:300ms"
		>
			total 0 — {t.home.showcase.subheading}
		</div>
	</div>
</section>
