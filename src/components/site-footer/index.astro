---
import type { Locale } from "@/lib/i18n";
import { getDictionary } from "@/lib/i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();
---

<!-- tmux status line -->
<footer class="flex w-full shrink-0 items-stretch border-t border-border bg-card/50 text-xs">
	<span class="flex items-center bg-accent px-3 py-1.5 font-semibold text-accent-foreground">
		{t.site.name}
	</span>
	<span class="hidden items-center px-3 text-muted-foreground sm:flex">
		{t.footer.tagline}
	</span>
	<span class="ml-auto flex items-center gap-1 px-3 py-1.5 text-muted-foreground">
		© {year} · mit
		<span class="cursor-blink" aria-hidden="true"></span>
	</span>
</footer>
