---
import type { Locale } from "@/lib/i18n";
import { getDictionary, localizePath } from "@/lib/i18n";
import type { getPostsByLocale } from "@/lib/blog";
import { Image } from "astro:assets";
import type { Page } from "astro";

type Post = Awaited<ReturnType<typeof getPostsByLocale>>[number];

interface Props {
	locale: Locale;
	page: Page<Post>;
	projects: string[];
	activeProject: string | null;
}

const { locale, page, projects, activeProject } = Astro.props;
const t = getDictionary(locale);
const prompt = "guest@glyndor:~$";
const posts = page.data;

// timeZone: "UTC" -- the date is a calendar day (a release date), not a
// timestamped moment; formatting in the server/viewer's local zone can
// shift a UTC-midnight date to the previous day.
const dateFormatter = new Intl.DateTimeFormat(locale, {
	year: "numeric",
	month: "short",
	day: "numeric",
	timeZone: "UTC",
});

const filterHref = (project: string | null) =>
	localizePath(project ? `/blog/project/${project}` : "/blog", locale);
---

<section class="w-full px-4 py-16 sm:px-8 lg:px-16 xl:px-24">
	<div class="w-full">
		<p class="rise text-sm">
			<span class="text-accent">{prompt}</span>
			<span class="ml-2 text-foreground">ls -l ~/blog</span>
		</p>
		<p class="rise mt-2 pl-4 text-sm text-muted-foreground" style="animation-delay:80ms">
			# {t.blog.subtitle}
		</p>
		<p class="rise mt-1 pl-4 text-xs text-muted-foreground/80" style="animation-delay:120ms">
			total {page.total}
		</p>

		{
			projects.length > 0 && (
				<div class="rise mt-4 flex flex-wrap gap-1" style="animation-delay:140ms">
					<a
						href={filterHref(null)}
						aria-current={activeProject === null ? "page" : undefined}
						class={
							activeProject === null
								? "border border-border-strong bg-card/50 px-3 py-1.5 text-xs uppercase tracking-wider text-foreground"
								: "border border-border-strong px-3 py-1.5 text-xs uppercase tracking-wider text-muted-foreground transition-colors hover:text-foreground"
						}
					>
						{t.blog.allTopics}
					</a>
					{projects.map((project) => (
						<a
							href={filterHref(project)}
							aria-current={activeProject === project ? "page" : undefined}
							class={
								activeProject === project
									? "border border-border-strong bg-card/50 px-3 py-1.5 text-xs uppercase tracking-wider text-foreground"
									: "border border-border-strong px-3 py-1.5 text-xs uppercase tracking-wider text-muted-foreground transition-colors hover:text-foreground"
							}
						>
							{project}
						</a>
					))}
				</div>
			)
		}

		{
			posts.length === 0 ? (
				<p class="rise mt-6 text-sm text-muted-foreground" style="animation-delay:160ms">
					# {t.blog.empty}
				</p>
			) : (
				<div
					class="rise mt-5 divide-y divide-border-strong border-y border-border-strong text-sm"
					style="animation-delay:160ms"
				>
					{posts.map((post) => (
						<a
							href={localizePath(`/blog/${post.slug}`, locale)}
							class="group grid grid-cols-[auto_1fr] items-center gap-4 px-2 py-4 transition-colors hover:bg-accent-soft sm:grid-cols-[5rem_7rem_1fr_auto]"
						>
							{post.data.banner ? (
								<Image
									src={post.data.banner}
									alt=""
									width={80}
									height={80}
									class="hidden size-14 border border-border-strong object-cover sm:block"
								/>
							) : (
								<span class="hidden size-14 border border-border-strong bg-card/50 sm:block" />
							)}
							<span class="whitespace-nowrap text-xs uppercase tracking-wider text-muted-foreground/70">
								{dateFormatter.format(post.data.date)}
							</span>
							<span class="col-span-2 sm:col-span-1">
								<span class="font-semibold text-foreground group-hover:text-accent">
									{post.data.title}
								</span>
								{post.data.project && (
									<span class="ml-2 whitespace-nowrap text-xs text-muted-foreground/60">
										#{post.data.project}
									</span>
								)}
								<span class="mt-0.5 block text-muted-foreground">{post.data.description}</span>
							</span>
							<span class="hidden self-center whitespace-nowrap text-xs uppercase tracking-wider text-muted-foreground transition-colors group-hover:text-accent sm:inline">
								[{t.blog.readMore}]
							</span>
						</a>
					))}
				</div>
			)
		}

		{
			page.lastPage > 1 && (
				<div class="rise mt-4 flex items-center justify-between text-xs text-muted-foreground">
					<a
						href={page.url.prev}
						class={
							page.url.prev
								? "text-accent transition-colors hover:underline"
								: "pointer-events-none text-muted-foreground/40"
						}
					>
						{page.url.prev && `← ${t.blog.prevPage}`}
					</a>
					<span>
						{t.blog.page} {page.currentPage} {t.blog.pageOfSeparator} {page.lastPage}
					</span>
					<a
						href={page.url.next}
						class={
							page.url.next
								? "text-accent transition-colors hover:underline"
								: "pointer-events-none text-muted-foreground/40"
						}
					>
						{page.url.next && `${t.blog.nextPage} →`}
					</a>
				</div>
			)
		}
	</div>
</section>
